pkgname=skystrike
pkgver=0.1.0
pkgrel=1
pkgdesc='City defense aeroplane combat game for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/skystrike "$pkgdir/usr/bin/skystrike"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/skystrike.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/skystrike.svg"
  install -Dm644 "$startdir/skystrike.desktop" "$pkgdir/usr/share/applications/skystrike.desktop"
}
